             build clock. Resolved by git-commit-id-maven-plugin (see build/plugins) at the initialize phase. -->
        <project.build.outputTimestamp>2026-09-11T13:25:36Z</project.build.outputTimestamp>
        <spring.boot.version>3.5.14</spring.boot.version>
        <spring.cloud.version>2025.0.2</spring.cloud.version>
